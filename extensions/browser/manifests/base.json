{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.1.0",
  "default_locale": "en",
  "description": "__MSG_extensionDescription__",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "__MSG_extensionName__"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "permissions": [
    "downloads",
    "contextMenus",
    "nativeMessaging",
    "storage",
    "notifications",
    "webRequest",
    "tabs",
    "activeTab",
    "cookies",
    "webNavigation"
  ],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "send-page-url": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "__MSG_commandSendPageUrl__"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/index.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
